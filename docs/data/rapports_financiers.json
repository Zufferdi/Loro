  "evenements_marquants": [
    {"year": 2014, "label": "Lancement rénovation Provence", "detail": "Loro commence la rénovation du 14-20 av. de Provence à Lausanne. Constructions au brut : 12,8 M (2013) → 30,5 M (2016)."},
    {"year": 2015, "label": "Décision BNS, taux négatifs", "detail": "La BNS supprime le taux plancher (jan. 2015). Loro mobilise 80+ M en placements long terme pour échapper aux intérêts négatifs."},
    {"year": 2016, "label": "Plateforme jeux en ligne", "detail": "Lancement de jeux.loro.ch. Portefeuille joueurs apparaît au bilan (2,7 M). Première dépréciation sur la plateforme."},
    {"year": 2018, "label": "Transition Deloitte → BDO", "detail": "Changement d'organe de révision après plus de 10 ans avec Deloitte. BDO SA prend le relais."},
    {"year": 2019, "label": "LJAr et RBJ → PBJ", "detail": "Entrée en vigueur de la Loi fédérale sur les jeux d'argent. Terminologie change. Gains jusqu'à 1 M exonérés d'impôt anticipé."},
    {"year": 2020, "label": "COVID-19", "detail": "PBJ -8 % (374 M vs 408 M). Commissions -7 %. Marketing -16 %. Délais paiement étendus à 90 j pour les dépositaires."},
    {"year": 2021, "label": "CORJA + autorisation 20 ans", "detail": "Concordat romand sur les jeux d'argent entre en vigueur. Loro = exploitante exclusive jusqu'en 2040. 3,3 M distribués à 800 cafés-restaurants COVID."},
    {"year": 2022, "label": "Vaud bascule à 25 %", "detail": "LVLJAr entre en vigueur le 1.1.2022. Vaud commence à prélever 25 % discrétionnaires (0 % avant). Pertes placements -15,6 M (marchés)."},
    {"year": 2023, "label": "Bond informatique", "detail": "Coûts IT de 16,8 M (2022) à 22,5 M (+34 %). Lancement EuroDreams. Investissements logiciels +20,5 M (record)."},
    {"year": 2024, "label": "Jackpot record + Fribourg 7→9 %", "detail": "Cycle 27 semaines Swiss Loto, gain record 64,6 M en mars. Euro + JO portent JouezSport +24 %. Fribourg de 7 à 9 %."},
    {"year": 2025, "label": "Reflux + Jura 17→20 %", "detail": "PBJ -2 % à 429,8 M (cycles Euromillions courts). Bénéfice 252 M (-2,4 %). EPT -10 (à 203). Jura passe de 17 à 20 %."}
  ]
